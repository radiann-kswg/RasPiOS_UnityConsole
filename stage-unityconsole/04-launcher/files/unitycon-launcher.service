[Unit]
Description=UnityConsole launcher (kiosk X session on tty1)
After=systemd-user-sessions.service network.target
Conflicts=getty@tty1.service

[Service]
User=player
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
TTYReset=yes
TTYVHangup=yes
UtmpIdentifier=tty1
WorkingDirectory=~
ExecStart=/usr/bin/startx /usr/lib/unityconsole/ucon-xsession -- :0 vt1 -nolisten tcp -quiet
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
