#!/bin/bash
# Unityアプリを box64 経由で実行する
# 使い方: ucon-run-app <アプリディレクトリ> [Unity起動引数...]
set -u

APP_DIR="${1:-}"
if [ -z "${APP_DIR}" ] || [ ! -d "${APP_DIR}" ]; then
    echo "usage: ucon-run-app <app-dir> [args...]" >&2
    exit 1
fi
shift

EXE="$(find "${APP_DIR}" -maxdepth 1 -name '*.x86_64' -type f | head -n 1)"
if [ -z "${EXE}" ]; then
    echo "実行ファイル(*.x86_64)が見つかりません: ${APP_DIR}" >&2
    exit 1
fi
chmod +x "${EXE}" 2>/dev/null || true

cd "${APP_DIR}" || { echo "アプリディレクトリへ移動できません: ${APP_DIR}" >&2; exit 1; }

# 再生するゲームは常に1本だけ。別のアプリが残っていたら先に畳んでから起動する。
# ランチャー経由なら重複は起きないが、SSH や保守作業からの直接起動で二重再生になっていた。
# ランチャーは終了確認ダイアログ中にゲームを SIGSTOP するため、TERM/KILL に CONT を添える。
APPS_ROOT="/var/lib/unityconsole/apps"
RUNNING_RE="^${APPS_ROOT}/.*\\.x86_64"

stop_running_apps() {
    local sig="$1" pid
    for pid in $(pgrep -f "${RUNNING_RE}" 2>/dev/null); do
        [ "${pid}" = "$$" ] && continue
        # ランチャー起動分は独立セッション＝プロセスグループごと畳む。単発起動はPID単体で。
        kill -"${sig}" -- "-${pid}" 2>/dev/null || kill -"${sig}" "${pid}" 2>/dev/null || true
        kill -CONT -- "-${pid}" 2>/dev/null || kill -CONT "${pid}" 2>/dev/null || true
    done
}

if pgrep -f "${RUNNING_RE}" >/dev/null 2>&1; then
    echo "ucon-run-app: 実行中のアプリを終了します（同時再生は1本まで）" >&2
    stop_running_apps TERM
    for _ in $(seq 50); do                      # TERM を 5 秒待つ
        pgrep -f "${RUNNING_RE}" >/dev/null 2>&1 || break
        sleep 0.1
    done
    stop_running_apps KILL
    sleep 0.5                                   # DRM/X のリースが解放されるのを待つ
fi


# RPi の V3D (Mesa) は素の GL バージョン報告が 3.1 のため、Unity(OpenGLCore) が要求する
# 3.3 相当へ引き上げる（RasPiOS_NTsWallpaper の run-signage.sh で実証済み。Vulkan アプリには無害）
export MESA_GL_VERSION_OVERRIDE=3.3
export MESA_GLSL_VERSION_OVERRIDE=330

# X にウィンドウマネージャが無く、ゲームの窓は入力フォーカスを得ない。SDL（Unity の Linux プレイヤーが
# ゲームパッド読み取りに使う）は既定で「フォーカスの無いアプリ」のパッド入力を捨てるため、背景でも受け取らせる。
# 無いと Input System 上は Gamepad として認識されるのにボタンが一切届かない（2026-09-20 実機・仮想パッドで確認）
export SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1

# X にウィンドウマネージャが無いため入力フォーカスが None のままで、キーボード入力はどの窓にも
# 配送されない（2026-09-21 に NTsWallpaper 機で実測。仮想キーボードのキーが無反応 →
# PointerRoot にした瞬間に届いた）。ポインタ下の窓＝全画面のゲームへキーが流れるようにする。
#
# 同じく WM が無いので、全画面指定（-screen-fullscreen 1）のゲームの窓を画面いっぱいへ広げる役もここで担う。
# Unity 6.7 (6000.7.0b2) の Linux プレイヤーは全画面要求を WM 任せにし、WM が無いと窓が -screen-width/height
# の大きさで中央に残る。描画はデスクトップ解像度で行うため、画面には左下だけが映り周囲が黒枠になる
# （2026-10-04 Pi 5 実測: 1366x768 画面に 960x540+203+114 の窓）。窓を root と同じ大きさへ
# XMoveResizeWindow すると Unity が追従し「downscaled viewport」で全面表示になった。6.6 までは無害。
# 窓の生成（box64 で数十秒）や Unity の取り直しに追従するため、起動後しばらく繰り返す。
# exec で box64 へ置き換わるので、ゲームの _NET_WM_PID は このシェルの $$ と一致する。
FIT_PID=0
prev=""
for a in "$@"; do
    [ "${prev}" = "-screen-fullscreen" ] && [ "${a}" = "1" ] && FIT_PID=$$
    prev="${a}"
done
fix_x_window() {
    FIT_PID="${FIT_PID}" python3 - <<'PY' 2>/dev/null || true
import ctypes, ctypes.util, os
x = ctypes.CDLL(ctypes.util.find_library("X11"))
c_p, c_ul, c_i, c_u = ctypes.c_void_p, ctypes.c_ulong, ctypes.c_int, ctypes.c_uint
x.XOpenDisplay.restype = c_p
x.XSetInputFocus.argtypes = [c_p, c_ul, c_i, c_ul]
x.XSync.argtypes = [c_p, c_i]
x.XDefaultRootWindow.restype = c_ul; x.XDefaultRootWindow.argtypes = [c_p]
x.XQueryTree.argtypes = [c_p, c_ul, ctypes.POINTER(c_ul), ctypes.POINTER(c_ul), ctypes.POINTER(ctypes.POINTER(c_ul)), ctypes.POINTER(c_u)]
x.XGetGeometry.argtypes = [c_p, c_ul, ctypes.POINTER(c_ul)] + [ctypes.POINTER(c_i)] * 2 + [ctypes.POINTER(c_u)] * 4
x.XInternAtom.restype = c_ul; x.XInternAtom.argtypes = [c_p, ctypes.c_char_p, c_i]
x.XGetWindowProperty.argtypes = [c_p, c_ul, c_ul, ctypes.c_long, ctypes.c_long, c_i, c_ul, ctypes.POINTER(c_ul),
                                 ctypes.POINTER(c_i), ctypes.POINTER(c_ul), ctypes.POINTER(c_ul), ctypes.POINTER(c_p)]
x.XMoveResizeWindow.argtypes = [c_p, c_ul, c_i, c_i, c_u, c_u]
d = x.XOpenDisplay(None)
if d:
    x.XSetInputFocus(d, 1, 2, 0)   # PointerRoot, RevertToPointerRoot, CurrentTime
    pid = int(os.environ.get("FIT_PID", "0"))
    if pid:
        def geom(w):
            g = [c_ul(), c_i(), c_i(), c_u(), c_u(), c_u(), c_u()]
            x.XGetGeometry(d, w, *[ctypes.byref(v) for v in g])
            return g[1].value, g[2].value, g[3].value, g[4].value
        def wm_pid(w):
            t, f, n, b, p = c_ul(), c_i(), c_ul(), c_ul(), c_p()
            x.XGetWindowProperty(d, w, x.XInternAtom(d, b"_NET_WM_PID", 0), 0, 1, 0, 0, ctypes.byref(t),
                                 ctypes.byref(f), ctypes.byref(n), ctypes.byref(b), ctypes.byref(p))
            return ctypes.cast(p, ctypes.POINTER(c_ul))[0] if p.value and n.value else None
        root = x.XDefaultRootWindow(d)
        _, _, rw, rh = geom(root)
        r, pa, ch, n = c_ul(), c_ul(), ctypes.POINTER(c_ul)(), c_u()
        if x.XQueryTree(d, root, ctypes.byref(r), ctypes.byref(pa), ctypes.byref(ch), ctypes.byref(n)):
            for w in [ch[i] for i in range(n.value)]:
                if wm_pid(w) == pid and geom(w) != (0, 0, rw, rh):
                    x.XMoveResizeWindow(d, w, 0, 0, rw, rh)
    x.XSync(d, 0)
PY
}
( for _ in $(seq 60); do sleep 3; fix_x_window; done ) &

# box64 動作設定（安定性優先。問題があれば BIGBLOCK を 1 に下げる）
export BOX64_DYNAREC_BIGBLOCK=2
export BOX64_DYNAREC_SAFEFLAGS=1
export BOX64_LOG=0

exec box64 "${EXE}" "$@"
