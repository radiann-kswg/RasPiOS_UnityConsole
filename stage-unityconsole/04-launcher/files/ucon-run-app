#!/bin/bash
# Unityアプリを box64 経由で実行する
# 使い方: ucon-run-app <アプリディレクトリ> [Unity起動引数...]
set -u

APP_DIR="${1:-}"
if [ -z "${APP_DIR}" ] || [ ! -d "${APP_DIR}" ]; then
    echo "usage: ucon-run-app <app-dir> [args...]" >&2
    exit 1
fi
shift

EXE="$(find "${APP_DIR}" -maxdepth 1 -name '*.x86_64' -type f | head -n 1)"
if [ -z "${EXE}" ]; then
    echo "実行ファイル(*.x86_64)が見つかりません: ${APP_DIR}" >&2
    exit 1
fi
chmod +x "${EXE}" 2>/dev/null || true

cd "${APP_DIR}" || { echo "アプリディレクトリへ移動できません: ${APP_DIR}" >&2; exit 1; }

# 再生するゲームは常に1本だけ。別のアプリが残っていたら先に畳んでから起動する。
# ランチャー経由なら重複は起きないが、SSH や保守作業からの直接起動で二重再生になっていた。
# ランチャーは終了確認ダイアログ中にゲームを SIGSTOP するため、TERM/KILL に CONT を添える。
APPS_ROOT="/var/lib/unityconsole/apps"
RUNNING_RE="^${APPS_ROOT}/.*\\.x86_64"

stop_running_apps() {
    local sig="$1" pid
    for pid in $(pgrep -f "${RUNNING_RE}" 2>/dev/null); do
        [ "${pid}" = "$$" ] && continue
        # ランチャー起動分は独立セッション＝プロセスグループごと畳む。単発起動はPID単体で。
        kill -"${sig}" -- "-${pid}" 2>/dev/null || kill -"${sig}" "${pid}" 2>/dev/null || true
        kill -CONT -- "-${pid}" 2>/dev/null || kill -CONT "${pid}" 2>/dev/null || true
    done
}

if pgrep -f "${RUNNING_RE}" >/dev/null 2>&1; then
    echo "ucon-run-app: 実行中のアプリを終了します（同時再生は1本まで）" >&2
    stop_running_apps TERM
    for _ in $(seq 50); do                      # TERM を 5 秒待つ
        pgrep -f "${RUNNING_RE}" >/dev/null 2>&1 || break
        sleep 0.1
    done
    stop_running_apps KILL
    sleep 0.5                                   # DRM/X のリースが解放されるのを待つ
fi


# RPi の V3D (Mesa) は素の GL バージョン報告が 3.1 のため、Unity(OpenGLCore) が要求する
# 3.3 相当へ引き上げる（RasPiOS_NTsWallpaper の run-signage.sh で実証済み。Vulkan アプリには無害）
export MESA_GL_VERSION_OVERRIDE=3.3
export MESA_GLSL_VERSION_OVERRIDE=330

# X にウィンドウマネージャが無く、ゲームの窓は入力フォーカスを得ない。SDL（Unity の Linux プレイヤーが
# ゲームパッド読み取りに使う）は既定で「フォーカスの無いアプリ」のパッド入力を捨てるため、背景でも受け取らせる。
# 無いと Input System 上は Gamepad として認識されるのにボタンが一切届かない（2026-09-20 実機・仮想パッドで確認）
export SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1

# box64 動作設定（安定性優先。問題があれば BIGBLOCK を 1 に下げる）
export BOX64_DYNAREC_BIGBLOCK=2
export BOX64_DYNAREC_SAFEFLAGS=1
export BOX64_LOG=0

exec box64 "${EXE}" "$@"
