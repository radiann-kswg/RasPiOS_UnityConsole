[Unit]
Description=UnityConsole USB gadget (CDC-NCM ethernet + CDC-ACM serial)
After=systemd-modules-load.service sys-kernel-config.mount
Before=dnsmasq.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/unityconsole/unitycon-gadget.sh start
ExecStop=/usr/lib/unityconsole/unitycon-gadget.sh stop

[Install]
WantedBy=multi-user.target
