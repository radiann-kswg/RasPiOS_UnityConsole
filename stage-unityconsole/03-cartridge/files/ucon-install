#!/bin/bash
# Unityアプリを1件SDカードへインストールする
# 使い方: ucon-install <zipファイル | アプリディレクトリ>
# 終了コード: 0=成功 1=不正/失敗 2=容量不足
set -u
source /usr/lib/unityconsole/ucon-lib.sh

target="${1:-}"
if [ -z "${target}" ]; then
    echo "usage: ucon-install <app.zip | app-dir>" >&2
    exit 1
fi

if [ -d "${target}" ]; then
    ucon_install_dir "${target}" "$(basename "${target}")"
    exit $?
fi

case "${target}" in
    *.zip|*.ZIP)
        ucon_install_zip "${target}"
        exit $?
        ;;
    *)
        echo "対応していない形式です（zipまたはディレクトリのみ）: ${target}"
        exit 1
        ;;
esac
