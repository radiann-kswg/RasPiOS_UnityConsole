#!/bin/bash
# SDカード上のUnityアプリをUSBメモリへバックアップ（退避＝移動）する
# 使い方: ucon-backup <アプリ名> [パーティションデバイス 例:/dev/sda1]
# 終了コード: 0=成功 1=失敗 2=USB側容量不足 3=USB未検出
# 画面には stdout の最終行が出る（詳細なエラーは stderr → journal）
set -u
# shellcheck source=/dev/null
source /usr/lib/unityconsole/ucon-lib.sh

NAME="${1:-}"
DEV="${2:-}"

if [ -z "${NAME}" ]; then
    echo "usage: ucon-backup <app-name> [/dev/sdX1]" >&2
    exit 1
fi

SRC="${APPS_DIR}/${NAME}"
if [ ! -d "${SRC}" ]; then
    echo "アプリが見つかりません: ${NAME}"
    exit 1
fi

# デバイス未指定なら最初のUSBパーティションを自動選択
if [ -z "${DEV}" ]; then
    DEV="$(lsblk -rpno NAME,TYPE | awk '$2=="part" && $1 ~ /\/dev\/sd/ {print $1; exit}')"
fi
if [ -z "${DEV}" ] || [ ! -b "${DEV}" ]; then
    echo "USBメモリが見つかりません"
    exit 3
fi

MNT="$(mktemp -d /run/unitycon-bak.XXXXXX)"
TMP=""     # 退避中の一時コピー（失敗時に cleanup で消す）
# trap から間接的に呼ばれるため shellcheck の到達性判定は無視する
# shellcheck disable=SC2317,SC2329
cleanup() {
    [ -n "${TMP}" ] && rm -rf "${TMP}"
    umount "${MNT}" 2>/dev/null || true
    rmdir "${MNT}" 2>/dev/null || true
}
trap cleanup EXIT

# -w: 書けない時に読み込み専用マウントへ黙って落ちない（カセット導入中は ro で使用中のため。2026-09-16 実機で確認）
if ! mount -w "${DEV}" "${MNT}"; then
    echo "USBメモリを書き込み用に開けません（カセット読み込み中なら終わってから再実行）"
    exit 1
fi

# 必要量はUSB側のクラスタ単位で見積もる（FAT32 は 32KB・exFAT は 128KB が普通で、SD上の du より膨らむ）
bs="$(stat -f -c %S "${MNT}")"
need="$(find "${SRC}" -printf '%y %s\n' |
    awk -v bs="${bs}" '{ n += ($1 == "d") ? 1 : int(($2 + bs - 1) / bs) } END { print int(n * bs / 1024) }')"
avail="$(df --output=avail -k "${MNT}" | tail -n 1 | tr -d ' ')"
if [ -z "${need}" ] || [ -z "${avail}" ]; then
    echo "容量の確認に失敗しました"
    exit 1
fi
if [ "${need}" -gt "${avail}" ]; then
    echo "USB側の空き容量不足 (必要 $((need / 1024))MB / 空き $((avail / 1024))MB)"
    exit 2
fi

# バックアップ先はカセットとして再認識できる /UnityGames/ に置く。
# 一時名へコピーして検証が通ってから差し替える（失敗してもUSB上の既存コピーを消さない）。
# 一時名は "." 始まり: ucon-usb-install は隠しディレクトリを導入対象にしない。
DEST_DIR="${MNT}/UnityGames"
DEST="${DEST_DIR}/${NAME}"
TMP="${DEST_DIR}/.${NAME}.tmp.$$"
if ! mkdir -p "${DEST_DIR}"; then
    echo "USBメモリに書き込めません"
    exit 1
fi
rm -rf "${TMP}"
# cp -a は FAT/exFAT で所有者を保存できず失敗する（2026-09-16 実機で確認）ので中身だけ写す。
# 実行ビットは再インストール時に ucon_install_dir が付け直す。
if ! cp -r "${SRC}" "${TMP}"; then
    echo "コピーに失敗しました"
    exit 1
fi
sync

# コピー検証（サイズ比較）後に差し替え、SD側を削除して容量を解放
copied="$(ucon_size_kb "${TMP}")"
if [ -z "${copied}" ] || [ "${copied}" -lt "$((need * 9 / 10))" ]; then
    echo "検証に失敗しました（コピーサイズ不一致）"
    exit 1
fi
rm -rf "${DEST}"
if ! mv "${TMP}" "${DEST}"; then
    echo "USB上での名前変更に失敗しました"
    exit 1
fi
TMP=""
sync
rm -rf "${SRC}"
sync

echo "${NAME} をUSBへ退避しました（USB挿入で再インストール可能）"
exit 0
