	(text "OS側: config.txt に dtoverlay=gpio-key,gpio=21,active_low=1,gpio_pull=up,keycode=172\nGPIO21 は SoC 内蔵プルアップ(約50k)。押下時 3.3V x 1k/51k = 約0.07V"
		(exclude_from_sim no)
		(at 88.9 97.79 0)
		(effects
